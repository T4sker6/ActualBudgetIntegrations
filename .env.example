# Skopiuj ten plik do .env i uzupełnij wartości. .env jest w .gitignore.

# Które banki przetwarzać (lista po przecinku). Dostępne: velo, pko
ENABLED_BANKS=velo

# --- Śmieciowe konto Gmail (IMAP, wspólne dla wszystkich banków) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=smieciowe@gmail.com
IMAP_APP_PASSWORD=                 # 16-znakowe App Password (wymaga 2FA na koncie)

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- Actual Budget ---
ACTUAL_BASE_URL=http://actual:5006
ACTUAL_PASSWORD=
ACTUAL_ENCRYPTION_PASSWORD=        # tylko jeśli budżet jest szyfrowany E2E (inaczej zostaw puste)
ACTUAL_VERIFY_SSL=true             # ustaw false, jeśli Actual ma self-signed HTTPS (pomija weryfikację certyfikatu)
ACTUAL_FILE=Budżet domowy          # nazwa pliku budżetu lub jego sync-id

# --- Hasła do PDF (per bank, potrzebne tylko dla włączonych banków) ---
VELO_PDF_PASSWORD=
PKO_PDF_PASSWORD=
